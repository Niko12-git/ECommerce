@inherits LayoutComponentBase
@inject AuthService AuthService
@inject CartService CartService
@inject NavigationManager Navigation

<div class="layout">
    <nav class="navbar">
        <div class="nav-brand">ECommerce Web</div>
        <div class="nav-links">
            @if (isAuthenticated)
            {
                <span class="nav-user"> Bienvenido! @userName (@userRole)</span>
                @if (userRole == "Admin")
                {
                    <a href="/products">Productos</a>
                    <a href="/users">Usuarios</a>
                }
                else
                {
                    <a href="/products">Tienda</a>
                }
                <a href="/my-orders">Mis Órdenes</a>
                <a href="/cart" class="cart-link">
                    Carrito
                    @if (cartCount > 0)
                    {
                        <span class="cart-badge">@cartCount</span>
                    }
                </a>
                <button class="btn-logout" @onclick="Logout">Cerrar sesión</button>
            }
            else
            {
                <a href="/login">Iniciar sesión</a>
                <a href="/register">Registrarse</a>
            }
        </div>
    </nav>

    <main class="main-content">
        @Body
    </main>
</div>

@code {
    private bool isAuthenticated;
    private string userName = string.Empty;
    private string userRole = string.Empty;
    private int cartCount = 0;

    protected override async Task OnInitializedAsync()
    {
        await AuthService.InitializeAsync();
        isAuthenticated = await AuthService.IsAuthenticatedAsync();
        if (isAuthenticated)
        {
            userName = await AuthService.GetUserNameAsync();
            userRole = await AuthService.GetUserRoleAsync();
        }

        // Suscribirse al evento del carrito para actualizar el contador
        CartService.OnCartChanged += UpdateCartCount;
        UpdateCartCount();
    }

    private void UpdateCartCount()
    {
        cartCount = CartService.TotalItems;
        InvokeAsync(StateHasChanged);
    }

    private async Task Logout()
    {
        CartService.Clear();
        await AuthService.LogoutAsync();
        Navigation.NavigateTo("/login", forceLoad: true);
    }

    // Importante: desuscribirse para evitar memory leaks
    public void Dispose()
    {
        CartService.OnCartChanged -= UpdateCartCount;
    }
}